rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ========================= HELPER FUNCTIONS =========================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function hasAdminRole(role) {
      return isAuthenticated() && request.auth.token.admin_role == role;
    }

    function hasPermission(permission) {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions[permission] == true;
    }

    function canCreateOwnUserDoc(uid) {
      return isUser(uid) &&
        !request.resource.data.keys().hasAny(['admin']) &&
        (
          !request.resource.data.keys().hasAny(['role']) ||
          request.resource.data.role in ['caregiver', 'client', null]
        );
    }

    function canUpdateOwnUserDoc(uid) {
      return isUser(uid) &&
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['role', 'admin']);
    }

    function getJob(jobId) {
      return get(/databases/$(database)/documents/jobs/$(jobId));
    }

    function isJobOwner(jobId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/jobs/$(jobId)) &&
        getJob(jobId).data.clientId == request.auth.uid;
    }

    function isConversationParticipant(conversationId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds.hasAny([request.auth.uid]);
    }

    // ========================= ADMIN COLLECTION (NEW) =========================
    match /admins/{adminId} {
      // Only admins can read other admins
      allow read: if isAdmin();
      
      // Super admin only can create/update/delete admins
      allow create, update, delete: if hasAdminRole('superadmin');
    }

    // ========================= AUDIT LOGS COLLECTION (NEW) =========================
    match /auditLogs/{logId} {
      // All admins can read audit logs if they have permission
      allow read: if hasPermission('canViewAuditLog');
      
      // Admin operations (via Cloud Function only - no direct writes)
      allow create: if false;
    }

    // ========================= USERS COLLECTION =========================
    match /users/{uid} {
      // Authenticated users can read profiles for discovery/messaging.
      allow read: if isAuthenticated();

      allow create: if canCreateOwnUserDoc(uid);
      allow update: if canUpdateOwnUserDoc(uid) || isAdmin();
      allow delete: if isAdmin();

      // ========================= VISITS SUBCOLLECTION =========================
      match /visits/{visitId} {
        allow read, create, update, delete: if isUser(uid) || isAdmin();
      }

      // ========================= PAYMENTS SUBCOLLECTION =========================
      match /payments/{paymentId} {
        allow read, create, update, delete: if isUser(uid) || isAdmin();
      }

      // ========================= CARE PLANS SUBCOLLECTION =========================
      match /carePlans/{carePlanId} {
        allow read, create, update, delete: if isUser(uid) || isAdmin();
      }
    }

    // ========================= JOBS COLLECTION =========================
    match /jobs/{jobId} {
      allow read: if isAuthenticated();

      // Only the authenticated client can create a job for themselves.
      allow create: if isAuthenticated() &&
        request.resource.data.clientId == request.auth.uid;

      // Job owner can modify/delete their own job. Admin can moderate any job.
      allow update, delete: if isJobOwner(jobId) || isAdmin();

      // ========================= APPLICATIONS SUBCOLLECTION =========================
      match /applications/{applicationId} {
        allow read: if isAuthenticated() &&
          (isJobOwner(jobId) || resource.data.caregiverId == request.auth.uid || isAdmin());

        allow create: if isAuthenticated() &&
          request.resource.data.caregiverId == request.auth.uid &&
          request.resource.data.jobId == jobId;

        allow update: if isAuthenticated() &&
          (isJobOwner(jobId) || resource.data.caregiverId == request.auth.uid || isAdmin());

        allow delete: if false;
      }

      // ========================= MESSAGES SUBCOLLECTION =========================
      match /messages/{messageId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid;

        allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }

      // ========================= BIDS SUBCOLLECTION =========================
      match /bids/{bidId} {
        allow read: if isAuthenticated();

        // One bid per caregiver by document id convention: bids/{caregiverId}
        allow create: if isAuthenticated() &&
          bidId == request.auth.uid &&
          request.resource.data.caregiverId == request.auth.uid &&
          request.resource.data.jobId == jobId &&
          request.resource.data.status == 'pending' &&
          getJob(jobId).data.status == 'open';

        // Bid owner can edit proposal/amount/duration while pending.
        allow update: if isAuthenticated() && (
          (
            resource.data.caregiverId == request.auth.uid &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'pending'
          ) ||
          // Job owner can approve/reject pending bids.
          (
            isJobOwner(jobId) &&
            resource.data.status == 'pending' &&
            (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected')
          )
        );

        allow delete: if false;
      }
    }

    // ========================= JOB_APPLICATIONS COLLECTION (GLOBAL) =========================
    // Store applications separately for easier querying by caregiverId
    match /job_applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.caregiverId == request.auth.uid || 
        (exists(/databases/$(database)/documents/jobs/$(resource.data.jobId)) &&
         get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.clientId == request.auth.uid) ||
        isAdmin()
      );

      // Caregivers can apply to open jobs
      allow create: if isAuthenticated() &&
        request.resource.data.caregiverId == request.auth.uid &&
        request.resource.data.status == 'applied' &&
        exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'open';

      // Job owner can accept/reject applications
      allow update: if isAuthenticated() &&
        exists(/databases/$(database)/documents/jobs/$(resource.data.jobId)) &&
        get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.clientId == request.auth.uid;

      allow delete: if false;
    }

    // ========================= REVIEWS COLLECTION =========================
    // 5-star reviews for completed jobs
    match /reviews/{reviewId} {
      // Anyone can read reviews (public ratings display)
      allow read: if isAuthenticated();

      // Authenticated users can submit reviews for completed jobs
      allow create: if isAuthenticated() &&
        request.resource.data.reviewerId == request.auth.uid &&
        (request.resource.data.reviewerRole == 'client' || request.resource.data.reviewerRole == 'caregiver') &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'completed';

      // Only the reviewer (admin) can update their own review
      allow update: if isAuthenticated() && (
        resource.data.reviewerId == request.auth.uid ||
        isAdmin()
      );

      // Never allow deletion (immutable history)
      allow delete: if false;
    }

    // ========================= CONVERSATIONS COLLECTION =========================
    match /conversations/{conversationId} {
      // Allow users to read conversations they're a participant in
      allow read: if isConversationParticipant(conversationId) || isAdmin();
      
      // Allow querying by participantIds for users who are in them
      // (Firestore will apply read rules to matched documents)
      allow list: if isAuthenticated();

      allow create: if isAuthenticated() &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() >= 2 &&
        request.resource.data.participantIds.hasAny([request.auth.uid]);

      allow update, delete: if isConversationParticipant(conversationId) || isAdmin();

      // ========================= CONVERSATION MESSAGES SUBCOLLECTION =========================
      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId) || isAdmin();

        allow create: if isConversationParticipant(conversationId) &&
          request.resource.data.senderId == request.auth.uid;

        allow delete: if isConversationParticipant(conversationId) &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // ========================= CALLS COLLECTION (WebRTC signaling) =========================
    // Structure:
    // calls/{callId} -> { callerId, conversationId, offer, answer }
    // calls/{callId}/callerCandidates/{cid}
    // calls/{callId}/calleeCandidates/{cid}
    match /calls/{callId} {
      // Only conversation participants may create/read/update/delete call docs
      allow create: if isAuthenticated() &&
        request.resource.data.conversationId is string &&
        // ensure caller is the authenticated user
        request.resource.data.callerId == request.auth.uid &&
        // ensure the caller is a participant in the conversation referenced
        exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)) &&
        get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participantIds.hasAny([request.auth.uid]);

      allow read: if isAuthenticated() &&
        resource.data.conversationId is string &&
        exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId)) &&
        get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds.hasAny([request.auth.uid]);

      // Allow updates only by participants; restrict which fields can be written
      allow update: if isAuthenticated() &&
        resource.data.conversationId is string &&
        exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId)) &&
        get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds.hasAny([request.auth.uid]) &&
        // Only allow adding an 'answer' or updating small metadata fields
        (request.resource.data.keys().hasOnly(['answer']) || request.resource.data.keys().hasOnly(['answer','updatedAt']));

      allow delete: if isAuthenticated() &&
        resource.data.conversationId is string &&
        exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId)) &&
        get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds.hasAny([request.auth.uid]);

      // callerCandidates subcollection
      match /callerCandidates/{candidateId} {
        allow create: if isAuthenticated() &&
          resource == null &&
          request.resource.data.uid == request.auth.uid &&
          // call exists and caller is a participant
          exists(/databases/$(database)/documents/calls/$(callId)) &&
          (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid ||
           (exists(/databases/$(database)/documents/conversations/$(get(/databases/$(database)/documents/calls/$(callId)).data.conversationId)) &&
           get(/databases/$(database)/documents/conversations/$(get(/databases/$(database)/documents/calls/$(callId)).data.conversationId)).data.participantIds.hasAny([request.auth.uid])));

        allow read: if isAuthenticated() &&
          exists(/databases/$(database)/documents/calls/$(callId)) &&
          exists(/databases/$(database)/documents/conversations/$(get(/databases/$(database)/documents/calls/$(callId)).data.conversationId)) &&
          get(/databases/$(database)/documents/conversations/$(get(/databases/$(database)/documents/calls/$(callId)).data.conversationId)).data.participantIds.hasAny([request.auth.uid]);

        allow delete: if false;
      }

      // calleeCandidates subcollection
      match /calleeCandidates/{candidateId} {
        allow create: if isAuthenticated() &&
          resource == null &&
          request.resource.data.uid == request.auth.uid &&
          exists(/databases/$(database)/documents/calls/$(callId)) &&
          exists(/databases/$(database)/documents/conversations/$(get(/databases/$(database)/documents/calls/$(callId)).data.conversationId)) &&
          get(/databases/$(database)/documents/conversations/$(get(/databases/$(database)/documents/calls/$(callId)).data.conversationId)).data.participantIds.hasAny([request.auth.uid]);

        allow read: if isAuthenticated() &&
          exists(/databases/$(database)/documents/calls/$(callId)) &&
          exists(/databases/$(database)/documents/conversations/$(get(/databases/$(database)/documents/calls/$(callId)).data.conversationId)) &&
          get(/databases/$(database)/documents/conversations/$(get(/databases/$(database)/documents/calls/$(callId)).data.conversationId)).data.participantIds.hasAny([request.auth.uid]);

        allow delete: if false;
      }
    }

    // ========================= TRANSACTIONS (payments) - SECURE =========================
    match /transactions/{txId} {
      // Users can read their own transactions, admins can read all
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.caregiverId == request.auth.uid || 
        isAdmin()
      );

      // Authenticated users can create their own transactions, Cloud Functions can also create
      allow create: if (isAuthenticated() && request.resource.data.clientId == request.auth.uid) || 
                       isAdmin() || 
                       !isAuthenticated();

      // Cloud Functions/admins can update transaction status
      allow update: if isAdmin() || !isAuthenticated();

      // Never allow deletion (audit trail)
      allow delete: if false;
    }

    // ========================= CAREGIVER WALLETS - SECURE =========================
    match /caregiver_wallets/{caregiverId} {
      // Only the caregiver and admins can read their own wallet
      allow read: if isAuthenticated() && (
        request.auth.uid == caregiverId || isAdmin()
      );

      // Cloud Functions can create wallets
      allow create: if isAdmin() || !isAuthenticated();
      
      // Cloud Functions/admins can update wallets
      allow update: if isAdmin() || !isAuthenticated();
      
      // Never allow deletion
      allow delete: if false;
    }

    // ========================= WITHDRAWALS - SECURE =========================
    match /withdrawals/{withdrawalId} {
      // Caregivers can read their own withdrawal requests, admins can read all
      allow read: if isAuthenticated() && (
        resource.data.caregiverId == request.auth.uid || isAdmin()
      );

      // Cloud Functions can create withdrawals
      allow create: if isAdmin() || !isAuthenticated();

      // Cloud Functions/admins can update withdrawal status (approve/reject)
      allow update: if isAdmin() || !isAuthenticated();

      // Never allow deletion (audit trail)
      allow delete: if false;
    }

    // ========================= PAYMENT FAILURES - AUDIT LOG =========================
    match /payment_failures/{failureId} {
      // Users can read their own failure logs, admins can read all
      allow read: if isAuthenticated() && (
        (resource.data.reference is string && 
         exists(/databases/$(database)/documents/transactions/$(resource.data.reference)) &&
         (
          get(/databases/$(database)/documents/transactions/$(resource.data.reference)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/transactions/$(resource.data.reference)).data.caregiverId == request.auth.uid
         )) ||
        isAdmin()
      );

      // Cloud Functions can create failure logs
      allow create: if isAdmin() || !isAuthenticated();

      // Never allow updates or deletions
      allow update, delete: if false;
    }

    // ========================= AUDIT LOGS =========================
    match /audit_logs/{logId} {
      // Only admins can read audit logs
      allow read: if isAdmin();

      // Cloud Functions can create
      allow create: if isAdmin() || !isAuthenticated();

      // Never allow updates or deletions
      allow update, delete: if false;
    }

    // ========================= PAYOUT BATCHES (NEW) =========================
    match /payoutBatches/{batchId} {
      // Admins can read all payout batches
      allow read: if isAdmin();
      
      // Cloud Functions create/update batches
      allow create, update: if !isAuthenticated();
      
      // Never allow deletion (audit trail)
      allow delete: if false;
      
      // Payout records within batch
      match /payouts/{payoutId} {
        allow read: if isAdmin() || (isAuthenticated() && resource.data.caregiverId == request.auth.uid);
        allow create, update: if !isAuthenticated();
        allow delete: if false;
      }
    }

    // ========================= REFUNDS COLLECTION (Phase 2) =========================
    match /refunds/{refundId} {
      // Admins can read all refunds
      allow read: if isAdmin();
      
      // Clients can read their own refunds
      allow read: if isAuthenticated() && resource.data.clientId == request.auth.uid;

      // Cloud Functions can create/update refunds (triggered by initiateInstantRefund)
      allow create, update: if !isAuthenticated();

      // Never allow deletion (audit trail)
      allow delete: if false;
    }

    // ========================= NOTIFICATIONS COLLECTION =========================
    // In-app notifications for job updates and reviews
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Cloud Functions can create notifications on job state changes
      allow create: if isAdmin() || !isAuthenticated();

      // Users can mark their own notifications as read
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead']);

      // Never allow deletion (audit trail)
      allow delete: if false;
    }

    // ========================= JOB ANALYTICS COLLECTION =========================
    // Caregiver performance metrics (completions, ratings, earnings)
    match /job_analytics/{caregiverId} {
      // Caregivers can read their own analytics, clients can see public profiles
      allow read: if isAuthenticated() && (
        request.auth.uid == caregiverId || isAdmin()
      );

      // Cloud Functions can create analytics doc
      allow create: if isAdmin() || !isAuthenticated();

      // Cloud Functions can update analytics on job completion/rating
      allow update: if isAdmin() || !isAuthenticated();

      // Never allow deletion
      allow delete: if false;
    }

    // ========================= DENY ALL OTHER ACCESS =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}